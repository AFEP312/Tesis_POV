n","# Fondo para imágenes transparentes\n","# y para el modo AJUSTAR\n","COLOR_FONDO = (0, 0, 0)\n","\n","\n","# ============================================================\n","# CARPETAS\n","# ============================================================\n","\n","BASE_DIR = \"/content/drive/MyDrive/TESIS_POV\"\n","\n","VIDEOS_DIR = os.path.join(\n","    BASE_DIR,\n","    \"Videos\"\n",")\n","\n","STOPMOTION_DIR = os.path.join(\n","    BASE_DIR,\n","    \"StopMotion\"\n",")\n","\n","\n","# ============================================================\n","# VALIDAR / CREAR CARPETAS\n","# ============================================================\n","\n","for carpeta in [\n","    VIDEOS_DIR,\n","    STOPMOTION_DIR\n","]:\n","\n","    if os.path.exists(carpeta):\n","\n","        if not os.path.isdir(carpeta):\n","\n","            raise Exception(\n","                f\"La ruta existe pero NO es una carpeta:\\n\"\n","                f\"{carpeta}\"\n","            )\n","\n","    else:\n","\n","        os.makedirs(carpeta)\n","\n","\n","# ============================================================\n","# COMPROBAR FFMPEG\n","# ============================================================\n","\n","try:\n","\n","    subprocess.run(\n","        [\"ffmpeg\", \"-version\"],\n","        stdout=subprocess.DEVNULL,\n","        stderr=subprocess.DEVNULL,\n","        check=True\n","    )\n","\n","except Exception:\n","\n","    raise Exception(\n","        \"FFmpeg no está disponible en este entorno de Colab.\"\n","    )\n","\n","\n","# ============================================================\n","# TITULO\n","# ============================================================\n","\n","print()\n","print(\"==================================================\")\n","print(\"     GENERADOR STOP MOTION / DIAPOSITIVAS POV\")\n","print(\"==================================================\")\n","print()\n","print(\"Resolución final : 200 x 200\")\n","print(\"Frames finales   :\", TOTAL_FRAMES_FINAL)\n","print(\"FPS              :\", FPS)\n","print(\"Duración final   :\", TOTAL_FRAMES_FINAL / FPS, \"segundos\")\n","print(\"Códec final      : H.264\")\n","print(\"Pixel format     : YUV420P\")\n","print()\n","\n","\n","# ============================================================\n","# PEDIR NOMBRE DEL VIDEO\n","# ============================================================\n","\n","nombre_video = input(\n","    \"Nombre del video final (sin .mp4): \"\n",").strip()\n","\n","\n","if not nombre_video:\n","\n","    raise Exception(\n","        \"Debes escribir un nombre para el video.\"\n","    )\n","\n","\n","# Limpiar caracteres problemáticos\n","nombre_video = (\n","    nombre_video\n","    .replace(\"/\", \"_\")\n","    .replace(\"\\\\\", \"_\")\n","    .replace(\":\", \"_\")\n","    .replace(\"*\", \"_\")\n","    .replace(\"?\", \"_\")\n","    .replace('\"', \"_\")\n","    .replace(\"<\", \"_\")\n","    .replace(\">\", \"_\")\n","    .replace(\"|\", \"_\")\n",")\n","\n","\n","# ============================================================\n","# ELEGIR MODO DE AJUSTE\n","# ============================================================\n","\n","print()\n","print(\"==================================================\")\n","print(\" MODO DE AJUSTE DE LAS IMAGENES\")\n","print(\"==================================================\")\n","print()\n","print(\"1 = RECORTAR\")\n","print(\"    Conserva proporción.\")\n","print(\"    Llena completamente 200x200.\")\n","print(\"    Puede recortar los bordes.\")\n","print()\n","print(\"2 = AJUSTAR\")\n","print(\"    Conserva toda la imagen.\")\n","print(\"    Puede agregar bordes negros.\")\n","print()\n","print(\"3 = ESTIRAR\")\n","print(\"    Fuerza directamente a 200x200.\")\n","print(\"    Puede deformar la imagen.\")\n","print()\n","\n","\n","opcion = input(\n","    \"Selecciona 1, 2 o 3 [1]: \"\n",").strip()\n","\n","\n","if opcion == \"\" or opcion == \"1\":\n","\n","    MODO = \"RECORTAR\"\n","\n","elif opcion == \"2\":\n","\n","    MODO = \"AJUSTAR\"\n","\n","elif opcion == \"3\":\n","\n","    MODO = \"ESTIRAR\"\n","\n","else:\n","\n","    raise Exception(\n","        \"Opción inválida.\"\n","    )\n","\n","\n","print()\n","print(\"Modo seleccionado:\", MODO)\n","\n","\n","# ============================================================\n","# CARPETA ESPECIFICA DEL PROYECTO\n","# ============================================================\n","\n","PROJECT_DIR = os.path.join(\n","    STOPMOTION_DIR,\n","    nombre_video\n",")\n","\n","UNIQUE_FRAMES_DIR = os.path.join(\n","    PROJECT_DIR,\n","    \"Imagenes_200x200\"\n",")\n","\n","\n","# ============================================================\n","# LIMPIAR PROYECTO ANTERIOR CON EL MISMO NOMBRE\n","# ============================================================\n","\n","if os.path.exists(PROJECT_DIR):\n","\n","    shutil.rmtree(\n","        PROJECT_DIR\n","    )\n","\n","\n","os.makedirs(\n","    UNIQUE_FRAMES_DIR\n",")\n","\n","\n","# ============================================================\n","# SUBIR IMAGENES\n","# ============================================================\n","\n","print()\n","print(\"==================================================\")\n","print(\" SUBIR IMAGENES\")\n","print(\"==================================================\")\n","print()\n","print(\n","    \"Selecciona entre 1 y 69 imágenes.\"\n",")\n","print()\n","print(\n","    \"El orden depende del nombre de los archivos.\"\n",")\n","print()\n","print(\n","    \"Ejemplo recomendado:\"\n",")\n","print()\n","print(\"01_inicio.png\")\n","print(\"02_texto.png\")\n","print(\"03_logo.png\")\n","print(\"04_final.png\")\n","print()\n","\n","\n","uploaded = files.upload()\n","\n","\n","if not uploaded:\n","\n","    raise Exception(\n","        \"No se seleccionaron imágenes.\"\n","    )\n","\n","\n","# ============================================================\n","# ORDEN NATURAL\n","# ============================================================\n","\n","def orden_natural(texto):\n","\n","    return [\n","\n","        int(parte)\n","        if parte.isdigit()\n","        else parte.lower()\n","\n","        for parte in re.split(\n","            r'(\\d+)',\n","            texto\n","        )\n","\n","    ]\n","\n","\n","nombres = sorted(\n","    uploaded.keys(),\n","    key=orden_natural\n",")\n","\n","\n","# ============================================================\n","# VALIDAR CANTIDAD\n","# ============================================================\n","\n","CANTIDAD_IMAGENES = len(\n","    nombres\n",")\n","\n","\n","print()\n","print(\n","    \"Imágenes recibidas:\",\n","    CANTIDAD_IMAGENES\n",")\n","\n","\n","if CANTIDAD_IMAGENES > TOTAL_FRAMES_FINAL:\n","\n","    raise Exception(\n","        \"\\n\"\n","        f\"Subiste {CANTIDAD_IMAGENES} imágenes.\\n\"\n","        f\"El máximo permitido es {TOTAL_FRAMES_FINAL}.\\n\\n\"\n","        \"No se eliminará ninguna automáticamente.\\n\"\n","        \"Vuelve a ejecutar y selecciona máximo 69.\"\n","    )\n","\n","\n","if CANTIDAD_IMAGENES == 0:\n","\n","    raise Exception(\n","        \"Debes subir al menos una imagen.\"\n","    )\n","\n","\n","# ============================================================\n","# FUNCION PARA CONVERTIR A 200x200\n","# ============================================================\n","\n","def convertir_imagen(\n","    datos_imagen,\n","    modo\n","):\n","\n","    imagen = Image.open(\n","        io.BytesIO(datos_imagen)\n","    )\n","\n","\n","    # --------------------------------------------------------\n","    # CORREGIR ORIENTACION EXIF\n","    # --------------------------------------------------------\n","\n","    imagen = ImageOps.exif_transpose(\n","        imagen\n","    )\n","\n","\n","    # --------------------------------------------------------\n","    # MANEJAR TRANSPARENCIA\n","    # --------------------------------------------------------\n","\n","    if imagen.mode in (\n","        \"RGBA\",\n","        \"LA\",\n","        \"P\"\n","    ):\n","\n","        imagen_rgba = imagen.convert(\n","            \"RGBA\"\n","        )\n","\n","\n","        fondo = Image.new(\n","            \"RGB\",\n","            imagen_rgba.size,\n","            COLOR_FONDO\n","        )\n","\n","\n","        fondo.paste(\n","            imagen_rgba,\n","            mask=imagen_rgba.getchannel(\"A\")\n","        )\n","\n","\n","        imagen = fondo\n","\n","    else:\n","\n","        imagen = imagen.convert(\n","            \"RGB\"\n","        )\n","\n","\n","    # --------------------------------------------------------\n","    # RECORTAR\n","    # --------------------------------------------------------\n","\n","    if modo == \"RECORTAR\":\n","\n","        resultado = ImageOps.fit(\n","            imagen,\n","            (ANCHO, ALTO),\n","            method=Image.Resampling.LANCZOS,\n","            centering=(0.5, 0.5)\n","        )\n","\n","\n","    # --------------------------------------------------------\n","    # AJUSTAR\n","    # --------------------------------------------------------\n","\n","    elif modo == \"AJUSTAR\":\n","\n","        imagen_ajustada = ImageOps.contain(\n","            imagen,\n","            (ANCHO, ALTO),\n","            method=Image.Resampling.LANCZOS\n","        )\n","\n","\n","        resultado = Image.new(\n","            \"RGB\",\n","            (ANCHO, ALTO),\n","            COLOR_FONDO\n","        )\n","\n","\n","        x = (\n","            ANCHO -\n","            imagen_ajustada.width\n","        ) // 2\n","\n","\n","        y = (\n","            ALTO -\n","            imagen_ajustada.height\n","        ) // 2\n","\n","\n","        resultado.paste(\n","            imagen_ajustada,\n","            (x, y)\n","        )\n","\n","\n","    # --------------------------------------------------------\n","    # ESTIRAR\n","    # --------------------------------------------------------\n","\n","    elif modo == \"ESTIRAR\":\n","\n","        resultado = imagen.resize(\n","            (ANCHO, ALTO),\n","            Image.Resampling.LANCZOS\n","        )\n","\n","\n","    else:\n","\n","        raise Exception(\n","            \"Modo de conversión desconocido.\"\n","        )\n","\n","\n","    return resultado.convert(\n","        \"RGB\"\n","    )\n","\n","\n","# ============================================================\n","# CONVERTIR TODAS LAS IMAGENES\n","# ============================================================\n","\n","print()\n","print(\"==================================================\")\n","print(\" CONVIRTIENDO IMAGENES A 200x200\")\n","print(\"==================================================\")\n","print()\n","\n","\n","imagenes_convertidas = []\n","\n","\n","for indice, nombre_original in enumerate(\n","    nombres,\n","    start=1\n","):\n","\n","    try:\n","\n","        imagen_final = convertir_imagen(\n","            uploaded[nombre_original],\n","            MODO\n","        )\n","\n","\n","        nombre_bmp = (\n","            f\"imagen_{indice:03d}.bmp\"\n","        )\n","\n","\n","        ruta_bmp = os.path.join(\n","            UNIQUE_FRAMES_DIR,\n","            nombre_bmp\n","        )\n","\n","\n","        imagen_final.save(\n","            ruta_bmp,\n","            \"BMP\"\n","        )\n","\n","\n","        imagenes_convertidas.append(\n","            {\n","                \"numero\": indice,\n","                \"original\": nombre_original,\n","                \"ruta\": ruta_bmp\n","            }\n","        )\n","\n","\n","        print(\n","            f\"[{indice:02d}/{CANTIDAD_IMAGENES}] \"\n","            f\"{nombre_original}\"\n","            f\" -> \"\n","            f\"{nombre_bmp}\"\n","        )\n","\n","\n","    except Exception as error:\n","\n","        print()\n","        print(\n","            \"ERROR procesando:\",\n","            nombre_original\n","        )\n","\n","        print(error)\n","\n","        raise\n","\n","\n","# ============================================================\n","# CALCULAR DISTRIBUCION DE LOS 69 FRAMES\n","# ============================================================\n","\n","print()\n","print(\"==================================================\")\n","print(\" DISTRIBUCION TEMPORAL\")\n","print(\"==================================================\")\n","print()\n","\n","\n","# ============================================================\n","# SI HAY EXACTAMENTE 69 IMAGENES\n","#\n","# Cada una se utiliza UNA SOLA VEZ.\n","# ============================================================\n","\n","if CANTIDAD_IMAGENES == TOTAL_FRAMES_FINAL:\n","\n","    repeticiones = [\n","        1\n","        for _ in range(\n","            CANTIDAD_IMAGENES\n","        )\n","    ]\n","\n","\n","# ============================================================\n","# SI HAY MENOS DE 69\n","#\n","# Se distribuyen hasta completar exactamente 69.\n","# ============================================================\n","\n","else:\n","\n","    repeticiones_base = (\n","        TOTAL_FRAMES_FINAL\n","        //\n","        CANTIDAD_IMAGENES\n","    )\n","\n","\n","    sobrantes = (\n","        TOTAL_FRAMES_FINAL\n","        %\n","        CANTIDAD_IMAGENES\n","    )\n","\n","\n","    repeticiones = []\n","\n","\n","    for i in range(\n","        CANTIDAD_IMAGENES\n","    ):\n","\n","        cantidad = repeticiones_base\n","\n","\n","        if i < sobrantes:\n","\n","            cantidad += 1\n","\n","\n","        repeticiones.append(\n","            cantidad\n","        )\n","\n","\n","# ============================================================\n","# MOSTRAR DISTRIBUCION\n","# ============================================================\n","\n","print(\n","    \"Imágenes distintas:\",\n","    CANTIDAD_IMAGENES\n",")\n","\n","print(\n","    \"Frames finales:\",\n","    sum(repeticiones)\n",")\n","\n","print()\n","\n","\n","for i, datos in enumerate(\n","    imagenes_convertidas\n","):\n","\n","    rep = repeticiones[i]\n","\n","\n","    duracion = (\n","        rep /\n","        FPS\n","    )\n","\n","\n","    print(\n","        f\"Imagen {i + 1:02d} \"\n","        f\"-> {rep:02d} frame(s) \"\n","        f\"-> {duracion:.1f} segundo(s)\"\n","    )\n","\n","\n","# ============================================================\n","# VERIFICAR TOTAL\n","# ============================================================\n","\n","TOTAL_CALCULADO = sum(\n","    repeticiones\n",")\n","\n","\n","if TOTAL_CALCULADO != TOTAL_FRAMES_FINAL:\n","\n","    raise Exception(\n","        \"Error interno: \"\n","        \"la distribución no suma 69 frames.\"\n","    )\n","\n","\n","# ============================================================\n","# RUTAS DE VIDEO\n","# ============================================================\n","\n","VIDEO_TEMPORAL = os.path.join(\n","    PROJECT_DIR,\n","    nombre_video + \"_TEMP.mp4\"\n",")\n","\n","\n","OUTPUT_VIDEO = os.path.join(\n","    VIDEOS_DIR,\n","    nombre_video + \".mp4\"\n",")\n","\n","\n","# ============================================================\n","# CREAR VIDEO TEMPORAL CON OPENCV\n","# ============================================================\n","\n","fourcc = cv2.VideoWriter_fourcc(\n","    *\"mp4v\"\n",")\n","\n","\n","video = cv2.VideoWriter(\n","    VIDEO_TEMPORAL,\n","    fourcc,\n","    FPS,\n","    (ANCHO, ALTO)\n",")\n","\n","\n","if not video.isOpened():\n","\n","    raise Exception(\n","        \"No se pudo inicializar VideoWriter.\"\n","    )\n","\n","\n","print()\n","print(\"==================================================\")\n","print(\" CREANDO VIDEO TEMPORAL\")\n","print(\"==================================================\")\n","print()\n","\n","\n","contador_frame = 0\n","\n","\n","for indice_imagen, datos in enumerate(\n","    imagenes_convertidas\n","):\n","\n","    ruta_bmp = datos[\"ruta\"]\n","\n","\n","    imagen_cv = cv2.imread(\n","        ruta_bmp\n","    )\n","\n","\n","    if imagen_cv is None:\n","\n","        video.release()\n","\n","        raise Exception(\n","            f\"No se pudo leer:\\n\"\n","            f\"{ruta_bmp}\"\n","        )\n","\n","\n","    # --------------------------------------------------------\n","    # SEGURIDAD: GARANTIZAR 200x200\n","    # --------------------------------------------------------\n","\n","    if (\n","        imagen_cv.shape[1] != ANCHO\n","        or\n","        imagen_cv.shape[0] != ALTO\n","    ):\n","\n","        imagen_cv = cv2.resize(\n","            imagen_cv,\n","            (ANCHO, ALTO),\n","            interpolation=cv2.INTER_LANCZOS4\n","        )\n","\n","\n","    # --------------------------------------------------------\n","    # REPETIR SEGUN LA DISTRIBUCION\n","    # --------------------------------------------------------\n","\n","    for repeticion in range(\n","        repeticiones[indice_imagen]\n","    ):\n","\n","        video.write(\n","            imagen_cv\n","        )\n","\n","\n","        contador_frame += 1\n","\n","\n","        print(\n","            f\"Frame \"\n","            f\"{contador_frame:02d}/\"\n","            f\"{TOTAL_FRAMES_FINAL}\",\n","            end=\"\\r\"\n","        )\n","\n","\n","video.release()\n","\n","\n","# ============================================================\n","# VERIFICAR QUE EL TEMPORAL EXISTE\n","# ============================================================\n","\n","if not os.path.exists(\n","    VIDEO_TEMPORAL\n","):\n","\n","    raise Exception(\n","        \"No se creó correctamente el video temporal.\"\n","    )\n","\n","\n","# ============================================================\n","# CONVERTIR A H.264 CON FFMPEG\n","# ============================================================\n","\n","print()\n","print()\n","print(\"==================================================\")\n","print(\" CONVIRTIENDO A H.264\")\n","print(\"==================================================\")\n","print()\n","\n","\n","comando_ffmpeg = [\n","\n","    \"ffmpeg\",\n","\n","    \"-y\",\n","\n","    # Video temporal\n","    \"-i\",\n","    VIDEO_TEMPORAL,\n","\n","    # Sin audio\n","    \"-an\",\n","\n","    # Codec H.264\n","    \"-c:v\",\n","    \"libx264\",\n","\n","    # Perfil compatible\n","    \"-profile:v\",\n","    \"baseline\",\n","\n","    # Formato de píxel compatible\n","    \"-pix_fmt\",\n","    \"yuv420p\",\n","\n","    # Mantener FPS\n","    \"-r\",\n","    str(FPS),\n","\n","    # Buena calidad\n","    \"-crf\",\n","    \"18\",\n","\n","    # Preset razonable\n","    \"-preset\",\n","    \"medium\",\n","\n","    # Metadatos al inicio del MP4\n","    # para mejorar reproducción / streaming\n","    \"-movflags\",\n","    \"+faststart\",\n","\n","    # Video final\n","    OUTPUT_VIDEO\n","]\n","\n","\n","resultado_ffmpeg = subprocess.run(\n","    comando_ffmpeg,\n","    stdout=subprocess.PIPE,\n","    stderr=subprocess.PIPE,\n","    text=True\n",")\n","\n","\n","# ============================================================\n","# COMPROBAR RESULTADO FFMPEG\n","# ============================================================\n","\n","if resultado_ffmpeg.returncode != 0:\n","\n","    print()\n","    print(\"ERROR DE FFMPEG:\")\n","    print()\n","    print(resultado_ffmpeg.stderr)\n","\n","    raise Exception(\n","        \"FFmpeg no pudo crear el video H.264.\"\n","    )\n","\n","\n","if not os.path.exists(\n","    OUTPUT_VIDEO\n","):\n","\n","    raise Exception(\n","        \"El video H.264 final no fue creado.\"\n","    )\n","\n","\n","print(\n","    \"Conversión H.264 terminada correctamente.\"\n",")\n","\n","\n","# ============================================================\n","# ELIMINAR VIDEO TEMPORAL\n","# ============================================================\n","\n","try:\n","\n","    os.remove(\n","        VIDEO_TEMPORAL\n","    )\n","\n","    print(\n","        \"Video temporal eliminado.\"\n","    )\n","\n","except Exception:\n","\n","    print(\n","        \"No se pudo eliminar el temporal, \"\n","        \"pero el video final fue creado.\"\n","    )\n","\n","\n","# ============================================================\n","# VERIFICAR VIDEO FINAL\n","# ============================================================\n","\n","cap = cv2.VideoCapture(\n","    OUTPUT_VIDEO\n",")\n","\n","\n","frames_mp4 = int(\n","    cap.get(\n","        cv2.CAP_PROP_FRAME_COUNT\n","    )\n",")\n","\n","\n","fps_mp4 = cap.get(\n","    cv2.CAP_PROP_FPS\n",")\n","\n","\n","ancho_mp4 = int(\n","    cap.get(\n","        cv2.CAP_PROP_FRAME_WIDTH\n","    )\n",")\n","\n","\n","alto_mp4 = int(\n","    cap.get(\n","        cv2.CAP_PROP_FRAME_HEIGHT\n","    )\n",")\n","\n","\n","cap.release()\n","\n","\n","# ============================================================\n","# OBTENER INFORMACION DEL CODEC CON FFPROBE\n","# ============================================================\n","\n","codec_detectado = \"desconocido\"\n","\n","pixel_format_detectado = \"desconocido\"\n","\n","\n","try:\n","\n","    resultado_probe = subprocess.run(\n","\n","        [\n","            \"ffprobe\",\n","\n","            \"-v\",\n","            \"error\",\n","\n","            \"-select_streams\",\n","            \"v:0\",\n","\n","            \"-show_entries\",\n","            \"stream=codec_name,pix_fmt\",\n","\n","            \"-of\",\n","            \"default=noprint_wrappers=1\",\n","\n","            OUTPUT_VIDEO\n","        ],\n","\n","        stdout=subprocess.PIPE,\n","\n","        stderr=subprocess.PIPE,\n","\n","        text=True\n","    )\n","\n","\n","    info_probe = resultado_probe.stdout\n","\n","\n","    for linea in info_probe.splitlines():\n","\n","        if linea.startswith(\n","            \"codec_name=\"\n","        ):\n","\n","            codec_detectado = linea.split(\n","                \"=\",\n","                1\n","            )[1]\n","\n","\n","        if linea.startswith(\n","            \"pix_fmt=\"\n","        ):\n","\n","            pixel_format_detectado = lin